{
  "name": "cinema-slime-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:share": "node scripts/render-share-pages.mjs",
    "build:bot": "vite build --config vite.bot.config.js",
    "preview": "vite preview",
    "test": "node --test src/*.test.js bot/*.test.js",
    "test:installer": "bash deploy/nginx/test/run-installer-tests.sh",
    "verify:curation": "node scripts/verify-curation.mjs",
    "publish:curation": "node scripts/publish-curation.mjs",
    "check:curation": "node scripts/check-curation.mjs",
    "check:coverage": "node scripts/check-coverage.mjs",
    "warm:artwork": "node scripts/warm-artwork-cache.mjs",
    "verify:edge": "node scripts/verify-edge-contract.mjs",
    "sandcastle": "npx tsx .sandcastle/main.ts"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.7.0",
    "@xmldom/xmldom": "^0.9.10",
    "discord.js": "^14.27.0",
    "tsx": "^4.22.4",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "markdown-it": "^14.2.0",
    "nostr-tools": "^2.23.5",
    "zod": "^4.4.3"
  }
}
